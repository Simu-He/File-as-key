/* =========================================================
   全局
   ========================================================= */

QWidget {
    font-size: 14px;
}


/* =========================================================
   ① Payload 文件拖拽区域
   ========================================================= */

QFrame#payloadDropArea {
    border: 2px dashed #8C8C8C;
    border-radius: 10px;
    background-color: #FAFAFA;
}

QFrame#payloadDropArea:hover {
    border: 2px dashed #606060;
    background-color: #F5F5F5;
}

QFrame#payloadDropArea:disabled {
    border: 2px dashed #D0D0D0;
    background-color: #F3F3F3;
}


/* =========================================================
   ② Payload 文件信息
   ========================================================= */

QFrame#payloadInfoCard {
    border: 1px solid #B5B5B5;
    border-radius: 8px;
    background-color: #FFFFFF;
}

QFrame#payloadInfoCard:disabled {
    border: 1px solid #D0D0D0;
    background-color: #F5F5F5;
}


/* =========================================================
   ③ Key 文件拖拽区域
   ========================================================= */

QFrame#keyDropArea {
    border: 2px dashed #8C8C8C;
    border-radius: 10px;
    background-color: #FAFAFA;
}

QFrame#keyDropArea:hover {
    border: 2px dashed #606060;
    background-color: #F5F5F5;
}

QFrame#keyDropArea:disabled {
    border: 2px dashed #D0D0D0;
    background-color: #F3F3F3;
}


/* =========================================================
   ④ Key 信息
   ========================================================= */

QFrame#keyInfoCard {
    border: 1px solid #B5B5B5;
    border-radius: 8px;
    background-color: #FFFFFF;
}

QFrame#keyInfoCard:disabled {
    border: 1px solid #D0D0D0;
    background-color: #F5F5F5;
}


/* =========================================================
   拖拽区域 +
   ========================================================= */

QLabel#dropIcon {
    font-size: 28px;
    font-weight: bold;
    color: #555555;
}


/* =========================================================
   拖拽区域标题
   ========================================================= */

QLabel#dropTitle {
    font-size: 15px;
    font-weight: bold;
    color: #303030;
}


/* =========================================================
   拖拽区域说明
   ========================================================= */

QLabel#dropDescription {
    font-size: 12px;
    color: #777777;
}


/* =========================================================
   文件信息 / Key 信息标题
   ========================================================= */

QLabel#sectionTitle {
    font-size: 14px;
    font-weight: bold;
    color: #303030;
}


/* =========================================================
   文件名
   ========================================================= */

QLabel#fileName {
    font-size: 14px;
    color: #222222;
}


/* =========================================================
   文件大小 / Fingerprint
   ========================================================= */

QLabel#fileInfo {
    font-size: 12px;
    color: #707070;
}


/* =========================================================
   选择文件 / 选择 Key 按钮
   ========================================================= */

QPushButton#selectFileButton {
    border: 1px solid #999999;
    border-radius: 6px;

    padding: 4px 18px;

    min-height: 26px;
    min-width: 100px;

    font-size: 13px;

    background-color: #FFFFFF;
    color: #303030;
}

QPushButton#selectFileButton:hover {
    border-color: #707070;
    background-color: #F2F2F2;
}

QPushButton#selectFileButton:pressed {
    background-color: #E5E5E5;
}

QPushButton#selectFileButton:disabled {
    border-color: #CCCCCC;
    background-color: #EFEFEF;
    color: #AAAAAA;
}


/* =========================================================
   清除按钮
   ========================================================= */

QPushButton#smallButton {
    border: 1px solid #AAAAAA;
    border-radius: 5px;

    padding: 3px 10px;

    min-height: 22px;

    font-size: 12px;

    background-color: #F8F8F8;
    color: #404040;
}

QPushButton#smallButton:hover {
    border-color: #808080;
    background-color: #EEEEEE;
}

QPushButton#smallButton:pressed {
    background-color: #E2E2E2;
}

QPushButton#smallButton:disabled {
    border-color: #D0D0D0;
    background-color: #F0F0F0;
    color: #B0B0B0;
}


/* =========================================================
   加密按钮
   ========================================================= */

QPushButton#primaryButton {
    border: 1px solid #777777;
    border-radius: 7px;

    min-height: 36px;

    padding: 4px 18px;

    font-size: 14px;
    font-weight: bold;

    background-color: #F5F5F5;
    color: #202020;
}

QPushButton#primaryButton:hover {
    border-color: #505050;
    background-color: #EDEDED;
}

QPushButton#primaryButton:pressed {
    background-color: #DDDDDD;
}

QPushButton#primaryButton:disabled {
    border-color: #CCCCCC;
    background-color: #F0F0F0;
    color: #AAAAAA;
}


/* =========================================================
   解密按钮
   ========================================================= */

QPushButton#secondaryButton {
    border: 1px solid #777777;
    border-radius: 7px;

    min-height: 36px;

    padding: 4px 18px;

    font-size: 14px;
    font-weight: bold;

    background-color: #F5F5F5;
    color: #202020;
}

QPushButton#secondaryButton:hover {
    border-color: #505050;
    background-color: #EDEDED;
}

QPushButton#secondaryButton:pressed {
    background-color: #DDDDDD;
}

QPushButton#secondaryButton:disabled {
    border-color: #CCCCCC;
    background-color: #F0F0F0;
    color: #AAAAAA;
}


/* =========================================================
   Progress Bar
   ========================================================= */

QProgressBar#progressBar {
    border: 1px solid #B5B5B5;
    border-radius: 5px;

    min-height: 18px;

    background-color: #F0F0F0;

    text-align: center;

    font-size: 11px;
    color: #303030;
}

QProgressBar#progressBar::chunk {
    border-radius: 4px;
    background-color: #808080;
}


/* =========================================================
   状态
   ========================================================= */

QLabel#statusTitle {
    font-size: 12px;
    font-weight: bold;
    color: #505050;
}

QLabel#statusLabel {
    font-size: 12px;
    color: #606060;
}